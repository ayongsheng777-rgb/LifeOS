# ===== LifeOS V2.0 环境示例 =====
# 复制为 .env 后填写；.env 已被 .gitignore 忽略

# ---- 对外端口 / Cloudflare Tunnel ----
# 隧道已将 lifeos.yshost.de5.net 指向 http://192.168.59.56:7208
# 因此服务须监听 7208：Docker 已映射 7208:8000；host 直跑用 --port 7208
# （容器内仍是 8000，compose 把外部 7208 转进来）

# ---- 基础设施 ----
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ---- OTP / 会话令牌 ----
# DATA_DIR 容器内为 /app/data（已挂卷）；本地开发可用 ./data
DATA_DIR=./data
# 品牌名/账号（中文需自动百分号编码，无需手动处理）
OTP_ISSUER=LifeOS
OTP_ACCOUNT=admin@lifeos
SESSION_TTL=43200
# 固定密钥模式（公网部署推荐）：设 OTP_SECRET 后不再显示绑定页，密钥由你私下下发
# OTP_SECRET=
# SESSION_SECRET=  # 留空则自动生成 64 位 hex 落盘

# ---- AI 模型（OpenAI 兼容，多模型库）----
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 国内模型必须留空；容器内访问宿主代理用 http://host.docker.internal:1080
AI_PROXY=
AI_USER_AGENT=
# 多模型库（JSON 数组字符串）：[{"id":"default","name":"DeepSeek","base_url":"...","model":"...","api_key":"...","proxy":"","user_agent":"","tags":["general"]}]
AI_MODELS=[]
AI_ACTIVE=default
# 场景→模型id 映射（JSON 对象字符串）：{"news":"default","stock":"default"}
SCENARIO_MODELS={}
# 长期记忆 embedding 模型（OpenAI 兼容 /embeddings，如 text-embedding-3-small）。
# 留空则长期记忆（Qdrant）不启用；启用后对话会向量化沉淀经验并检索参考。
# 维度须与 app/memory/vector_memory.py 的 vector_size（默认 1536）一致。
EMBEDDING_MODEL=

# ---- 飞书（可先用扫码授权流自动填，也可在此手动填）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENABLED=false

# ---- 前端 SPA 托管 ----
# 指向构建产物 frontend/dist（由前端 `npm run build` 产出）。
# 设了之后 Web 控制台与 API 同源，无需跨域；不设在 / 返回服务信息而非页面。
# Docker 已内置 FRONTEND_DIST=/app/frontend/dist；本地直跑可设：
# FRONTEND_DIST=./frontend/dist
FRONTEND_DIST=./frontend/dist

# ---- Phase 7 数据突变备份（本地磁盘 + NAS）----
# 本地备份根目录（必填，确保存在且可写）；NAS 填已挂载的可写路径，留空则不备份 NAS
LOCAL_BACKUP_ROOT=F:\LifeOS_BAK
NAS_BACKUP_ROOT=
# 每个目标保留最近 N 天
BACKUP_RETENTION_DAYS=7
# 每日定时备份时刻（0-23，默认凌晨 3 点）
BACKUP_SCHEDULE_HOUR=3
